{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Realm.Full.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Full.slnx",
        "--filter",
        "Category!=UI",
        "--verbosity",
        "normal",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-shared",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/RealmEngine.Shared.Tests/RealmEngine.Shared.Tests.csproj",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-core",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/RealmEngine.Core.Tests/RealmEngine.Core.Tests.csproj",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-data",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/RealmEngine.Data.Tests/RealmEngine.Data.Tests.csproj",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-with-coverage",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Realm.Full.slnx",
        "--filter",
        "Category!=UI",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "generate-coverage-report",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/generate-coverage-report.ps1"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "test-coverage",
      "dependsOn": ["test-with-coverage", "generate-coverage-report"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/Realm.Full.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "rebuild",
      "dependsOn": ["clean", "build"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "generate-version",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/generate-version.ps1",
        "-OutputFormat",
        "string"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "download-assets",
      "type": "shell",
      "command": "powershell",
      "args": ["-File", "${workspaceFolder}/scripts/download-assets.ps1"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      }
    },
    // ── Veldrath ─────────────────────────────────────────────────────────
    {
      "label": "build-veldrath-server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Veldrath.Server/Veldrath.Server.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run-veldrath-server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Veldrath.Server/Veldrath.Server.csproj",
        "--no-build"
      ],
      "isBackground": true,
      "dependsOn": "build-veldrath-server",
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Veldrath\\.Server starting",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "test-veldrath-server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Veldrath.Server.Tests/Veldrath.Server.Tests.csproj",
        "--verbosity",
        "normal",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "test-veldrath-all",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Veldrath.slnx",
        "--filter",
        "Category!=UI",
        "--verbosity",
        "normal",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build-veldrath-discord",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Veldrath.Discord/Veldrath.Discord.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run-veldrath-discord",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Veldrath.Discord/Veldrath.Discord.csproj",
        "--no-build"
      ],
      "isBackground": true,
      "dependsOn": "build-veldrath-discord",
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Veldrath\\.Discord starting",
          "endsPattern": "Gateway: Ready"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "test-veldrath-discord",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Veldrath.Discord.Tests/Veldrath.Discord.Tests.csproj",
        "--verbosity",
        "normal",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build-veldrath-assets",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Veldrath.Assets/Veldrath.Assets.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "test-veldrath-assets",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Veldrath.Assets.Tests/Veldrath.Assets.Tests.csproj",
        "--verbosity",
        "normal",
        "--collect",
        "XPlat Code Coverage",
        "--settings",
        "coverage.runsettings",
        "--results-directory",
        "${workspaceFolder}/coverage-results"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    // ── SvelteKit web client ────────────────────────────────────────────────
    {
      "label": "web:dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/web/client" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^.*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "web:build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/web/client" },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "web:test",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "options": { "cwd": "${workspaceFolder}/web/client" },
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    // ── Multi-client / Debug ─────────────────────────────────────────────────
    // ── Docker ───────────────────────────────────────────────────────────────
    {
      "label": "docker-compose-up",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "docker-compose-up-db",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "postgres", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "docker-compose-down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
