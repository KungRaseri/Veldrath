{
	"name": "@veldrath/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"coverage": "vitest run --coverage",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:game": "playwright test tests/game-loop.e2e.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output ../shared/src/db/auth.schema.ts --yes",
		"db:migrate-identity": "node ../scripts/migrate-identity-accounts.mjs"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.4",
		"@lucide/svelte": "^1.70.0",
		"@microsoft/signalr": "^10.0.11",
		"@veldrath/shared": "*",
		"better-auth": "^1.7.12",
		"bits-ui": "^2.20.6",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.16",
		"marked": "^18.1.3",
		"postgres": "^3.4.9",
		"sanitize-html": "^2.18.1",
		"simple-icons": "^16.37.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.65.0",
		"@skeletonlabs/skeleton": "^5.0.4",
		"@skeletonlabs/skeleton-svelte": "^5.0.4",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"auth": "^1.7.18",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^30.1.3",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.7",
		"vitest": "^5.0.5"
	},
	"optionalDependencies": {
		"@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
		"@tailwindcss/oxide-linux-x64-musl": "4.3.5"
	}
}
