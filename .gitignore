# Generated e2e summary (scripts/e2e-summary.mjs) — the comment on the PR is the copy that matters.
E2EReport/

# DocFX static site output
/_site/

# DocFX generated API YAML metadata (produced during docs build — do not commit).
# The landing page at api/index.md IS committed: docfx.json lists it as content so /api/ resolves
# to a real page instead of 404ing, and the Dockerfile no longer has to fabricate one.
/api/*
!/api/index.md

# Local smoke scripts and runtime artifacts (never committed)
/scripts/dev/

# Local e2e stack pid file (scripts/e2e-stack.sh)
.e2e-server.pid
